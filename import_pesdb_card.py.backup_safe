import json
import os
import argparse
import urllib.request
import urllib.error
from pathlib import Path

INPUT = Path("player_parsed_v2.json")

POSITIONS = [
    "GK", "CB", "LB", "RB", "DMF", "CMF", "LMF",
    "RMF", "AMF", "LWF", "RWF", "SS", "CF"
]

def load_payload():
    if not INPUT.exists():
        raise FileNotFoundError("player_parsed_v2.json topilmadi")

    p = json.loads(INPUT.read_text(encoding="utf-8"))

    position_index = p.get("position")
    position = (
        POSITIONS[position_index]
        if isinstance(position_index, int)
        and 0 <= position_index < len(POSITIONS)
        else ""
    )

    source_player_id = str(p.get("source_player_id", "")).strip()
    featured_id = p.get("featured_id")

    if not source_player_id or featured_id is None:
        raise ValueError("PESDB player ID yoki featured ID yo'q")

    source_card_id = f"{source_player_id}:{featured_id}"

    # Karta yaratish uchun API payload
    card = {
        "player_name": p["name"],
        "nationality": p["nationality"],
        "club": p["club"],
        "source": "PESDB",
        "source_card_id": source_card_id,
        "card_name": p["card_name"],
        "rating": p["overall_rating"],
        "card_type": p["card_type"],
        "position": position,
        "playing_style": p["attacking_playing_style"],
        "image": p.get("image_url", ""),
        "release_date": "2026-10-29"
    }

    # API booster nomlarining string ro'yxatini kutadi.
    raw_boosters = p.get("boosters", [])
    if isinstance(raw_boosters, list):
        booster_names = [
            b["name"]
            for b in raw_boosters
            if isinstance(b, dict) and isinstance(b.get("name"), str)
            and b["name"].strip()
        ]
    else:
        booster_names = []

    # Qo'shimcha ma'lumotlar yo'qolmasligi uchun JSON ichida saqlanadi.
    physics = {
        "static_stats": p.get("static_stats", {}),
        "player_details": p.get("details", {}),
        "booster_details": p.get("boosters", {}),
        "defensive_playing_style": p.get(
            "defensive_playing_style", ""
        ),
        "weak_foot_accuracy_value": None,
        "available_positions": p.get("available_positions", [])
    }

    roles = {
        "ai_playing_styles": p.get("ai_playing_styles", []),
        "position_index": position_index
    }

    details = {
        "base_ovr": p.get("overall_rating"),
        "max_ovr": p.get("max_overall"),
        "height_cm": p.get("height_cm"),
        "weight_kg": p.get("weight_kg"),
        "age": p.get("age"),
        "stats": p.get("stats", {}),
        "position_ratings": {},
        "skills": p.get("skills", []),
        "boosters": booster_names,
        "max_build": {},
        "physics": physics,
        "roles": roles,
        "source": "PESDB"
    }

    return card, details


def post_json(url, payload, token):
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")

    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}"
        },
        method="POST"
    )

    with urllib.request.urlopen(req, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Haqiqiy importni bajarish"
    )
    parser.add_argument(
        "--url",
        default=os.environ.get(
            "EFHUB_API",
            "http://127.0.0.1:5001"
        )
    )
    args = parser.parse_args()

    card, details = load_payload()

    print("=== IMPORT TEKSHIRUVI ===")
    print("Futbolchi:", card["player_name"])
    print("Karta:", card["card_name"])
    print("OVR:", card["rating"])
    print("Pozitsiya:", card["position"])
    print("Manba ID:", card["source_card_id"])
    print("Statlar:", len(details["stats"]))
    print("Skills:", len(details["skills"]))
    print("Boosters:", details["boosters"])
    print("Jismoniy ko'rsatkichlar:",
          len(details["physics"]["static_stats"]))

    if not args.apply:
        print("\nSINOV REJIMI: bazaga hech narsa yozilmadi.")
        print("Import uchun keyin --apply ishlatiladi.")
        return

    token = os.environ.get("ADMIN_TOKEN", "")
    if not token:
        raise RuntimeError(
            "ADMIN_TOKEN topilmadi. Import bajarilmadi."
        )

    base = args.url.rstrip("/")

    print("\n1. Karta API orqali yuborilmoqda...")
    result = post_json(
        base + "/api/import-pesdb-card",
        card,
        token
    )

    print("API javobi:", result)

    card_id = result.get("card", {}).get("id")
    if not card_id:
        raise RuntimeError("API javobida card ID topilmadi")

    if result.get("duplicate"):
        print("Karta oldin mavjud. Tafsilotlar o'zgartirilmadi.")
        return

    print("\n2. Karta tafsilotlari yuborilmoqda...")
    detail_result = post_json(
        f"{base}/api/cards/{card_id}/details",
        details,
        token
    )

    print("Tafsilotlar:", detail_result)
    print("\nIMPORT MUVAFFAQIYATLI. Card ID:", card_id)


if __name__ == "__main__":
    main()
